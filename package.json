{
  "name": "unchanged-attachments-to-oss",
  "version": "0.1.7",
  "description": "Obsidian plugin: upload immutable attachments to Aliyun OSS with dynamic signed URLs.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy:test": "npm run build && node scripts/deploy-test.mjs",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node tests/build-tests.mjs && node --test .test-dist/*.test.js .test-dist/*/*.test.js"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "oss",
    "aliyun"
  ],
  "author": "xukai",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.2",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
